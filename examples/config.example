# /etc/default/backup-k8s
# Shared by backup-k8s.sh and restore-k8s.sh. Mode 600, owned by root.
# Keep this file out of git — it holds your real bucket name and paths.

# rclone destination for cluster backups (remote:bucket/prefix). Required.
R2_REMOTE="r2:my-bucket/cluster"

# Optional secondary copy. Skipped with a warning if not mounted.
LOCAL_MOUNT="/mnt/backup"
LOCAL_ROOT="/mnt/backup/k8s-backups"
LOCAL_RETENTION_DAYS=30

# etcd static pod name. Default: etcd-$(hostname)
# ETCD_POD="etcd-my-control-plane"

# Restore only: defaults are $(hostname) and the primary IPv4 address.
# MASTER_NAME="my-control-plane"
# MASTER_IP="10.0.0.10"
